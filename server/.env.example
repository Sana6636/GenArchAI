# Server
PORT=5000
NODE_ENV=development

# Firebase Firestore
# Download service account key from: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Place the JSON file in the server directory and set the path below
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Cloudinary (free tier) - Replace with your credentials
# Sign up at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# HuggingFace (free) - Replace with your token
HUGGINGFACE_API_KEY=your_huggingface_token

# Groq (free) - Replace with your API key
GROQ_API_KEY=your_groq_api_key

# Google Gemini
GEMINI_API_KEY=your_gemini_key
